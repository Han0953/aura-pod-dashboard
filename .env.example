# Blynk Cloud IoT Configuration
# Salin file ini menjadi .env dan masukkan Auth Token Blynk Anda
VITE_BLYNK_AUTH_TOKEN=your_blynk_auth_token_here
VITE_BLYNK_SERVER_URL=https://blynk.cloud

# Dashboard Operator Credentials (Optional, default: admin / aurapod2026)
VITE_AUTH_USERNAME=admin
VITE_AUTH_PASSWORD=aurapod2026

# Bio-AI Engine Configuration (Vercel Serverless / Backend)
# Masukkan API Key Anda di sini atau di menu Environment Variables Vercel
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
